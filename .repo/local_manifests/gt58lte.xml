name: Build iyad aziez os

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Set up Crave CLI
      run: |
        mkdir -p ${HOME}/bin
        curl -s https://raw.githubusercontent.com/accupara/crave/main/get_crave.sh | bash -s -- ${HOME}/bin
        echo "${HOME}/bin" >> $GITHUB_PATH
        
        mkdir -p ${HOME}/.crave
        echo "[crave]" > ${HOME}/.crave/crave.conf
        echo "username = ${{ secrets.CRAVE_USERNAME }}" >> ${HOME}/.crave/crave.conf
        echo "password = ${{ secrets.CRAVE_PASSWORD }}" >> ${HOME}/.crave/crave.conf

    - name: Initialize and Customize ROM (iyad aziez os)
      run: |
        crave run -- "
        # 1. تهيئة سورس LineageOS الصحيح
        repo init -u https://github.com/LineageOS/android.git -b lineage-16.0 --git-lfs --depth=1
        
        # 2. تنزيل ملف Local Manifest
        mkdir -p .repo/local_manifests
        curl -o .repo/local_manifests/gt58lte.xml https://raw.githubusercontent.com/${{ github.repository }}/main/.repo/local_manifests/gt58lte.xml
        
        # 3. مزامنة السورس كود
        repo sync -c -j\$(nproc --all) --force-sync --no-clone-bundle --no-tags
        
        # 4. التعديل على اسم النظام ليكون iyad aziez os
        sed -i 's/PRODUCT_PROPERTY_OVERRIDES += \\/PRODUCT_PROPERTY_OVERRIDES += \\\\n    ro.modversion=iyad_aziez_os_9.0 \\\\n    ro.lineage.version=iyad_aziez_os_gt58lte \\\\n    /g' vendor/lineage/config/common.mk
        
        # 5. تفعيل الروت
        export WITH_SU=true
        sed -i 's/export WITH_SU=.*/export WITH_SU=true/g' vendor/lineage/config/common.mk
        
        # 6. تحميل Magisk تلقائياً
        mkdir -p vendor/extra
        curl -Lo vendor/extra/Magisk.zip https://github.com/topjohnwu/Magisk/releases/download/v27.0/Magisk-v27.0.apk
        
        # 7. بدء البناء
        source build/envsetup.sh
        lunch lineage_gt58lte-userdebug
        mka bacon -j\$(nproc --all)
        "

    - name: Pull build output from Crave
      run: |
        crave pull devicename/*.zip || true

    - name: Upload System ZIP to GitHub Releases
      uses: softprops/action-gh-release@v2
      with:
        tag_name: "v1.0-${{ github.run_id }}"
        name: "iyad aziez os v1.0"
        files: "*.zip"
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
