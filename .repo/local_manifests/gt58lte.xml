name: Build iyad aziez os

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Set up Crave CLI
      run: |
        mkdir -p ${HOME}/bin
        curl -s https://githubusercontent.com | bash -s -- ${HOME}/bin
        echo "${HOME}/bin" >> $GITHUB_PATH
        
        echo "[crave]" > ${HOME}/.crave/crave.conf
        echo "username = ${{ secrets.CRAVE_USERNAME }}" >> ${HOME}/.crave/crave.conf
        echo "password = ${{ secrets.CRAVE_PASSWORD }}" >> ${HOME}/.crave/crave.conf

    - name: Initialize and Customize ROM (iyad aziez os)
      run: |
        crave run -- "
        repo init -u https://github.com -b lineage-16.0 --git-lfs --depth=1
        
        mkdir -p .repo/local_manifests
        curl -o .repo/local_manifests/gt58lte.xml https://githubusercontent.com{{ github.repository }}/main/.repo/local_manifests/gt58lte.xml
        
        repo sync -c -j\$(nproc --all) --force-sync --no-clone-bundle --no-tags
        
        sed -i 's/PRODUCT_PROPERTY_OVERRIDES += \\/PRODUCT_PROPERTY_OVERRIDES += \\\\n    ro.modversion=iyad_aziez_os_9.0 \\\\n    ro.lineage.version=iyad_aziez_os_gt58lte \\\\n    /g' vendor/lineage/config/common.mk
        
        export WITH_SU=true
        sed -i 's/export WITH_SU=.*/export WITH_SU=true/g' vendor/lineage/config/common.mk
        
        source build/envsetup.sh
        lunch lineage_gt58lte-userdebug
        mka bacon -j\$(nproc --all)
        "

    - name: Upload System ZIP to GitHub Releases
      uses: softprops/action-gh-release@v2
      with:
        files: crave_downloads/*.zip
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

